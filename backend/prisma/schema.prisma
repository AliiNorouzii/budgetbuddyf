// BudgetBuddy data model
//
// - Business data lives in the `app` schema; secrets (password hashes and
//   session hashes) live in the private `auth` schema, linked to users only by id.
// - Every table has an internal auto-increment `rowId` (PK, used for joins and
//   sorting) and a short public `randId` (6 chars: 3 = day since 2026-01-01 in
//   base36, 3 = random). Only `randId` is ever exposed by the API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "auth"]
}

enum AccountType {
  CASH
  BANK
  CARD
  DIGITAL_WALLET

  @@schema("app")
}

enum TransactionType {
  INCOME
  EXPENSE

  @@schema("app")
}

// ───────────────────────────── app schema ─────────────────────────────

model User {
  rowId     BigInt   @id @default(autoincrement())
  randId    String   @unique @db.VarChar(6)
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential   Credential?
  sessions     Session[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]

  @@map("users")
  @@schema("app")
}

model Account {
  rowId     BigInt      @id @default(autoincrement())
  randId    String      @unique @db.VarChar(6)
  userRowId BigInt
  name      String
  type      AccountType @default(CASH)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User          @relation(fields: [userRowId], references: [rowId], onDelete: Cascade)
  transactions Transaction[]

  @@index([userRowId])
  @@map("accounts")
  @@schema("app")
}

model Category {
  rowId     BigInt   @id @default(autoincrement())
  randId    String   @unique @db.VarChar(6)
  userRowId BigInt
  name      String
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userRowId], references: [rowId], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userRowId, name])
  @@index([userRowId])
  @@map("categories")
  @@schema("app")
}

model Transaction {
  rowId           BigInt          @id @default(autoincrement())
  randId          String          @unique @db.VarChar(6)
  userRowId       BigInt
  accountRowId    BigInt
  categoryRowId   BigInt?
  type            TransactionType
  amount          BigInt // Toman, always positive; `type` gives the sign
  transactionDate DateTime
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user     User      @relation(fields: [userRowId], references: [rowId], onDelete: Cascade)
  account  Account   @relation(fields: [accountRowId], references: [rowId], onDelete: Cascade)
  category Category? @relation(fields: [categoryRowId], references: [rowId], onDelete: SetNull)

  @@index([userRowId, transactionDate])
  @@index([accountRowId])
  @@index([categoryRowId])
  @@map("transactions")
  @@schema("app")
}

model Budget {
  rowId         BigInt   @id @default(autoincrement())
  randId        String   @unique @db.VarChar(6)
  userRowId     BigInt
  categoryRowId BigInt
  month         String   @db.VarChar(7) // YYYY-MM
  limitAmount   BigInt
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User     @relation(fields: [userRowId], references: [rowId], onDelete: Cascade)
  category Category @relation(fields: [categoryRowId], references: [rowId], onDelete: Cascade)

  @@unique([userRowId, categoryRowId, month])
  @@index([userRowId])
  @@map("budgets")
  @@schema("app")
}

// ───────────────────────────── auth schema ────────────────────────────

model Credential {
  rowId        BigInt   @id @default(autoincrement())
  userRowId    BigInt   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userRowId], references: [rowId], onDelete: Cascade)

  @@map("credentials")
  @@schema("auth")
}

model Session {
  rowId      BigInt   @id @default(autoincrement())
  randId     String   @unique @db.VarChar(6)
  userRowId  BigInt
  tokenHash  String   @unique @db.Char(64) // sha256(token), raw token only lives in the cookie
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime // lastUsedAt + 24h (sliding)
  rotatedAt  DateTime? // set once the session was replaced; it then only lives for a short grace period
  userAgent  String?
  ip         String?

  user User @relation(fields: [userRowId], references: [rowId], onDelete: Cascade)

  @@index([userRowId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("auth")
}
